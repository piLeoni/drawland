{
  "name": "drawland",
  "version": "0.2.0",
  "description": "OpenStreetMap drawn as layered pen-plotter SVGs, styled by a short JavaScript profile",
  "keywords": ["plotter", "pen plotter", "map", "openstreetmap", "svg", "cartography", "axidraw", "generative art"],
  "license": "AGPL-3.0-only",
  "homepage": "https://draw.land/docs#dev-node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piLeoni/drawland.git",
    "directory": "bindings/node"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "drawland": "cli.js"
  },
  "files": ["index.js", "index.d.ts", "native.js", "native.d.ts", "cli.js", "*.node", "README.md", "LICENSE"],
  "engines": {
    "node": ">= 18"
  },
  "napi": {
    "binaryName": "drawland",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --js native.js --dts native.d.ts",
    "build:debug": "napi build --platform --js native.js --dts native.d.ts",
    "test": "node --test test.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3"
  }
}
